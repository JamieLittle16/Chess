+@njit(cache=False, inline="never")
+def _advance_residual_state_into(
+    board: np.ndarray,
+    side: int,
+    move: int,
+    parent: np.ndarray,
+    child: np.ndarray,
+) -> None:
+    """Update the learned residual without duplicating its large body into every search caller."""
+    from_square = move_from(move)
+    to_square = move_to(move)
+    promotion = move_promotion(move)
+    moving_signed = int(board[from_square])
+    moving_piece = abs(moving_signed)
+
+    captured_square = to_square
+    captured_signed = int(board[to_square])
+    if move & FLAG_EP:
+        captured_square = to_square - 8 * side
+        captured_signed = int(board[captured_square])
+
+    rook_from = -1
+    rook_to = -1
+    if move & FLAG_CASTLE:
+        if to_square == 6:
+            rook_from, rook_to = 7, 5
+        elif to_square == 2:
+            rook_from, rook_to = 0, 3
+        elif to_square == 62:
+            rook_from, rook_to = 63, 61
+        else:
+            rook_from, rook_to = 56, 59
+
+    # Learned V13 residual. Ordinary moves update two scalar perspective sums with only a
+    # handful of weight lookups. If the moving side's own king changes frame, rebuild only that
+    # perspective from the virtual child position; the opponent perspective still uses a delta.
+    white_king_parent = int(parent[EVAL_WHITE_KING])
+    black_king_parent = int(parent[EVAL_BLACK_KING])
+    placed_signed = side * promotion if promotion else moving_signed
+
+    # White perspective.
+    if moving_piece == KING and side == WHITE:
+        child[EVAL_RESIDUAL_WHITE] = _rebuild_residual_after_move(
+            board, side, move, WHITE, to_square
+        )
+    else:
+        total = int(parent[EVAL_RESIDUAL_WHITE])
+        total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(WHITE, white_king_parent, moving_signed, from_square)])
+        if captured_signed != EMPTY:
+            total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(WHITE, white_king_parent, captured_signed, captured_square)])
+        total += int(RESIDUAL_WEIGHTS[_residual_feature_index(WHITE, white_king_parent, placed_signed, to_square)])
+        if move & FLAG_CASTLE:
+            total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(WHITE, white_king_parent, side * ROOK, rook_from)])
+            total += int(RESIDUAL_WEIGHTS[_residual_feature_index(WHITE, white_king_parent, side * ROOK, rook_to)])
+        child[EVAL_RESIDUAL_WHITE] = total
+
+    # Black perspective.
+    if moving_piece == KING and side != WHITE:
+        child[EVAL_RESIDUAL_BLACK] = _rebuild_residual_after_move(
+            board, side, move, -WHITE, to_square
+        )
+    else:
+        total = int(parent[EVAL_RESIDUAL_BLACK])
+        total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(-WHITE, black_king_parent, moving_signed, from_square)])
+        if captured_signed != EMPTY:
+            total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(-WHITE, black_king_parent, captured_signed, captured_square)])
+        total += int(RESIDUAL_WEIGHTS[_residual_feature_index(-WHITE, black_king_parent, placed_signed, to_square)])
+        if move & FLAG_CASTLE:
+            total -= int(RESIDUAL_WEIGHTS[_residual_feature_index(-WHITE, black_king_parent, side * ROOK, rook_from)])
+            total += int(RESIDUAL_WEIGHTS[_residual_feature_index(-WHITE, black_king_parent, side * ROOK, rook_to)])
+        child[EVAL_RESIDUAL_BLACK] = total
+
