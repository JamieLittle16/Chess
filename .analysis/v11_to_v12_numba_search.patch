+@njit(cache=False, inline="never")
+def _is_elementary_dead_material(board: np.ndarray, state: np.ndarray) -> bool:
+    # Cheap exact draw recognition for K vs K, K+B vs K and K+N vs K.
+    # EVAL_PHASE is zero/one only in these tiny-material regimes, so normal
+    # middlegame nodes return before touching the board.
+    if int(state[EVAL_PHASE]) > 1:
+        return False
+    minors = 0
+    for square in range(64):
+        piece = abs(int(board[square]))
+        if piece == PAWN or piece == ROOK or piece == QUEEN:
+            return False
+        if piece == KNIGHT or piece == BISHOP:
+            minors += 1
+            if minors > 1:
+                return False
+    return True
+
