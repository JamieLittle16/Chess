+def _has_nonpawn_material(board: np.ndarray, side: int) -> bool:
+    # Conservative zugzwang gate used only on shallow scout nodes. Early exit makes this much
+    # cheaper than full move generation in ordinary middlegames.
+    for square in range(64):
+        signed_piece = int(board[square])
+        if signed_piece * side > 0:
+            piece = abs(signed_piece)
+            if piece == KNIGHT or piece == BISHOP or piece == ROOK or piece == QUEEN:
+                return True
+    return False
+
